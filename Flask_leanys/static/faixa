.faixa {
            background-color: rgb(73, 73, 73);
            position: fixed;
            top: 0;
            width: 100%;
            height: 1.7cm;
            display: flex;
            justify-content: space-between;
            padding: 0 20px;
            align-items: center;
            box-sizing: border-box;
            z-index: 1000;
        }

        h1 {
            color: rgb(255, 255, 255);
            margin: 0;
            z-index: 1001;
        }

        nav ul {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            gap: 20px;
        }

        nav li {
            margin-left: 20px;
        }

        nav a {
            text-decoration: none;
            color: white;
            font-size: 18px;
            font-weight: bold;
            transition: color 0.3s;
            z-index: 1001
        }

        nav a:hover {
            color: rgb(158, 128, 221);
        }
